{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认窗口权限：不含 devtools（开发期用 devtools 能力由 debug 构建单独放开）",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "sql:default",
    "sql:allow-execute",
    "geolocation:allow-check-permissions",
    "geolocation:allow-request-permissions",
    "geolocation:allow-get-current-position",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "dialog:allow-open",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "sparrow-storage:allow-pick-folder",
    "sparrow-storage:allow-storage-access",
    "sparrow-storage:allow-request-storage-access"
  ]
}
